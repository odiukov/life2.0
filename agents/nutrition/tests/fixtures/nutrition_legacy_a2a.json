              "kind": "data"
            }
          ]
        },
        "contextId": "ctx-1",
        "kind": "artifact-update",
        "lastChunk": true,
        "taskId": "task-1"
      },
      {
        "append": false,
        "artifact": {
          "artifactId": "<uuid>",
          "name": "analysis",
          "parts": [
            {
              "kind": "text",
              "text": "fixture output"
            }
