# .env.example
POSTGRES_DB=lifeagents
POSTGRES_USER=lifeagents
POSTGRES_PASSWORD=lifeagents
QDRANT_HOST=qdrant
QDRANT_PORT=6333
ORCHESTRATOR_URL=http://orchestrator:8000
SLEEP_AGENT_URL=http://agent-sleep:8001
WORKOUT_AGENT_URL=http://agent-workout:8002
NUTRITION_AGENT_URL=http://agent-nutrition:8003
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Comma- or space-separated Telegram allowlist: numeric user IDs and/or @usernames.
# Username matching is case-insensitive; the leading @ is optional.
# Leave empty = open to anyone. Find your id via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
GARMIN_EMAIL=your-garmin@email.com
GARMIN_PASSWORD=your-garmin-password
YAZIO_EMAIL=your-yazio@email.com
YAZIO_PASSWORD=your-yazio-password
SYNC_SERVICE_URL=http://sync-service:8080

# -------- LLM provider --------
# One of: anthropic | openrouter | gemini | groq | ollama
LLM_PROVIDER=openrouter
# Optional override. Each provider has a sensible default.
# LLM_MODEL=

# Set the key that matches LLM_PROVIDER:
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434  # only for ollama from Docker

# --- Mood agent / coach ---
# Coach uses Groq free-tier exclusively to keep cost at zero. Do NOT point this
# at a paid provider — the code fails fast when Groq is unavailable rather than
# silently falling back.
MOOD_COACH_PROVIDER=groq
MOOD_COACH_MODEL=llama-3.3-70b-versatile
MAX_COACH_TURNS=6

# Evening check-in (default off; flip to true to opt in)
MOOD_EVENING_CHECKIN=false
MOOD_EVENING_CHECKIN_TIME=21:00
MOOD_EVENING_CHECKIN_TZ=Europe/Kyiv

# Google Calendar MCP (Wave 2a)
# OAuth client JSON is read via file mount at ./gcp-oauth.keys.json
# (download from Google Cloud Console → OAuth Client → Download JSON)
MCP_GOOGLE_CALENDAR_URL=http://calendar-mcp:3000
MCP_GOOGLE_CALENDAR_TRANSPORT=streamable_http

# Home Assistant MCP (Wave 1 2.3)
# HA Green / HA OS / HA Container — long-lived token from Profile → Security.
# Both must be set for HA tools to load; either missing = skip HA (orchestrator boots clean).
HA_BASE_URL=http://192.168.1.85:8123
HA_TOKEN=
