# .env.example
POSTGRES_DB=lifeagents
POSTGRES_USER=lifeagents
POSTGRES_PASSWORD=lifeagents
QDRANT_HOST=qdrant
QDRANT_PORT=6333
ORCHESTRATOR_URL=http://orchestrator:8000
SLEEP_AGENT_URL=http://agent-sleep:8001
WORKOUT_AGENT_URL=http://agent-workout:8002
NUTRITION_AGENT_URL=http://agent-nutrition:8003
TELEGRAM_BOT_TOKEN=your-bot-token-here
GARMIN_EMAIL=your-garmin@email.com
GARMIN_PASSWORD=your-garmin-password
YAZIO_EMAIL=your-yazio@email.com
YAZIO_PASSWORD=your-yazio-password
SYNC_SERVICE_URL=http://sync-service:8080

# LLM provider for the health agent: anthropic (default) | openrouter
LLM_PROVIDER=anthropic
# Optional model override. Defaults: claude-sonnet-4-6 (anthropic) /
# openrouter/elephant-alpha (openrouter).
# LLM_MODEL=
# Required when LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini gemini-embedding-001 — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
