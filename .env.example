# .env.example
POSTGRES_DB=lifeagents
POSTGRES_USER=lifeagents
POSTGRES_PASSWORD=lifeagents
QDRANT_HOST=qdrant
QDRANT_PORT=6333
ORCHESTRATOR_URL=http://orchestrator:8000
SLEEP_AGENT_URL=http://agent-sleep:8001
WORKOUT_AGENT_URL=http://agent-workout:8002
NUTRITION_AGENT_URL=http://agent-nutrition:8003
TELEGRAM_BOT_TOKEN=your-bot-token-here
GARMIN_EMAIL=your-garmin@email.com
GARMIN_PASSWORD=your-garmin-password
YAZIO_EMAIL=your-yazio@email.com
YAZIO_PASSWORD=your-yazio-password
SYNC_SERVICE_URL=http://sync-service:8080

# -------- LLM provider --------
# One of: anthropic | openrouter | gemini | groq | ollama | claude-cli
LLM_PROVIDER=openrouter
# Optional override. Each provider has a sensible default.
# LLM_MODEL=

# Set the key that matches LLM_PROVIDER:
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434  # only for ollama from Docker

# claude-cli: ANTHROPIC_API_KEY is populated by scripts/export-auth.sh
# (OAuth token from macOS Keychain). Token expires ~8h.
