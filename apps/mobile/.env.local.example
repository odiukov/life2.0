# Copy to .env.local and edit.
# Modes: mock | local | cloud
EXPO_PUBLIC_API_MODE=local

# Local-mode base URL. Override per host:
#   iOS Simulator:         http://localhost:8000
#   Android Emulator:      http://10.0.2.2:8000
#   Physical iPhone/Android on same Wi-Fi: http://<mac-lan-ip>:8000
#     Get the Mac's IP with: ./scripts/mac-ip.sh
#   Tailscale (recommended for off-network device): http://<mac-hostname>.tail-scale.ts.net:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloud-mode base URL (P0 populates this). Ignored unless EXPO_PUBLIC_API_MODE=cloud.
# EXPO_PUBLIC_API_BASE_URL_CLOUD=https://api.life-agents.app

# Supabase auth (leave empty to boot in unauthenticated dev mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local dev without a Supabase project: run the backend with AUTH_MODE=dev and
# point the app at a seeded demo user (see scripts/seed_demo_data.py).
# Ignored as soon as EXPO_PUBLIC_SUPABASE_URL is set.
# EXPO_PUBLIC_DEV_USER_ID=de000000-0000-4000-8000-000000000001
