{
  "expo": {
    "name": "life-agents",
    "slug": "life-agents",
    "icon": "./assets/icon.png",
    "scheme": "lifeagents",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lifeagents.mobile"
    },
    "android": {
      "package": "app.lifeagents.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
